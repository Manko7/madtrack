{
  "manifest_version": 3,
  "name": "MadTrack",
  "version": "1.0",
  "author": "Manko",
  "description": "A modern, standalone Timetracking extension capturing durations and tasks.",
  "icons": {
    "128": "madtrack_icon.svg"
  },
  "action": {
    "default_title": "Toggle MadTrack",
    "default_icon": "madtrack_icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "style.css", "app.js", "madtrack_icon.png", "madtrack_icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}